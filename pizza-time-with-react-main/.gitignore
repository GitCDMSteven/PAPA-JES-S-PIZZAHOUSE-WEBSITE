# --- General ---
# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Node.js / Frontend (in root) ---
# Dependency directories
node_modules/

# Build output
dist/
build/

# Environment variables file (sensitive)
.env
.env.local
.env.*.local

# Vite specific cache
.vite/

# --- Python / Backend (in /backend) ---
# Virtual environment directory
backend/venv/
backend/.venv/

# Python cache files
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd

# Backend environment variables file (sensitive)
backend/.env.backend

# Flask instance folder
backend/instance/

# --- IDE & Editor Config ---
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini